# Copy this file to .env for local development:  cp .env.example .env
# Never commit .env. In production, use a protected environment file instead
# (see "VPS deployment" in README.md).

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The AI model provider: set exactly ONE of these keys.
#
# Google Gemini: key from https://aistudio.google.com/apikey
# The only provider here that can listen to voice messages.
GEMINI_API_KEY=
#
# Or xAI Grok: key from https://console.x.ai
XAI_API_KEY=

# PostgreSQL connection string for the bot's runtime role.
# Example: postgres://tgbot:password@127.0.0.1:5432/tgbot?sslmode=disable
DB_POSTGRES_URL=

# --- Model ------------------------------------------------------------------

# Gemini model, used when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-3.6-flash

# Models to try, in order, when the main one is overloaded (503), over its
# limits (429) or does not answer. Empty: the provider's defaults (for
# Gemini: gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite).
# "none": no fallback. When all fail, they are tried once more after a pause.
FALLBACK_MODELS=

# Backup provider, asked only when every model above failed (busy, out of
# quota, no answer). Any OpenAI-compatible API; the defaults are Groq, which
# has a free tier (key from https://console.groq.com/keys). It cannot hear
# voice messages, so it gets their transcript. Empty: no backup.
BACKUP_API_KEY=
# BACKUP_BASE_URL=https://api.groq.com/openai/v1
# BACKUP_MODEL=openai/gpt-oss-120b

# Live data (rates, weather, prayer times, news, Wikipedia and crypto) needs
# no key. Football needs a free football-data.org key; empty: no football.
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
# Optional CoinGecko demo key; empty: keyless calls with a shared quota.
COINGECKO_DEMO_KEY=

# Grok model, used when XAI_API_KEY is set. Pick one that accepts images.
XAI_MODEL=grok-4

# Upper limit on tokens in one model reply.
MAX_OUTPUT_TOKENS=1024

# --- Photos, stickers and voice messages -------------------------------------

# Largest file the bot downloads to show the model, in MB (1 to 20).
MAX_MEDIA_MB=5

# Longest voice message the bot listens to, in seconds. Longer ones are
# described to the model but not sent.
MAX_VOICE_SECONDS=120

# --- Drawing pictures (Gemini only) -----------------------------------------

# Let the bot draw pictures. Needs billing on the Gemini key: the free tier
# has no image quota.
ENABLE_IMAGE_GENERATION=true

# Gemini model that draws.
IMAGE_MODEL=gemini-3.1-flash-image

# Pictures per user per day. Owners have no limit. 0 lets only owners draw.
DAILY_IMAGE_LIMIT=2

# --- Limits -----------------------------------------------------------------

# How many recent messages are sent to the model as context.
MAX_HISTORY_MESSAGES=20

# How many tool calls the model may make while answering one message.
MAX_TOOL_CALLS_PER_TURN=4

# Number of workers, i.e. how many messages are processed at the same time.
MAX_CONCURRENT_REQUESTS=10

# Messages each user may send per minute.
USER_RATE_LIMIT_PER_MINUTE=10

# Answers each user gets per day in private chats, from midnight in
# GROUP_HISTORY_TIMEZONE. The first message past it gets one notice, later
# ones nothing until the next day. Owners have no limit; admins in
# ADMIN_USER_IDS do. Commands are not counted, nor a turn that failed with an
# error. Groups have their own limits below. Counted in the database, so it
# holds on Vercel too. 0 turns it off.
PRIVATE_DAILY_LIMIT=10
# Whom private chats are answered for: on (everyone), owners, or off (groups only).
# A group of fewer than five members (the bot counted) counts as one.
# PRIVATE_CHATS=on

# Time budget, in seconds, for answering one message (model + tools).
REQUEST_TIMEOUT_SECONDS=45

# Longest user message accepted, in characters.
MAX_INPUT_CHARS=4000

# Chat history is kept this many days, then deleted (once a day on Vercel,
# hourly with long polling). 0 keeps it forever.
RETENTION_DAYS=1

# --- Access -----------------------------------------------------------------

# Comma-separated Telegram user IDs with administrator rights. Example: 12345,67890
ADMIN_USER_IDS=

# Comma-separated commands only administrators may use. Example: model,about
ADMIN_COMMANDS=

# --- Character --------------------------------------------------------------

# The character's name. It is put into the personality prompt, and is the
# word the bot answers to in groups unless BOT_WAKE_WORDS says otherwise.
BOT_DISPLAY_NAME=Maria

# The character's personality and rules, given to the model on every request.
# "{name}" is replaced by BOT_DISPLAY_NAME. Leave empty for the built-in
# character: playful rather than cruel, brief, answering in the speaker's
# language and script, with limits on what it jokes about.
# See "The character" in README.md before replacing it.
PERSONA_PROMPT=

# --- Groups -----------------------------------------------------------------
# In groups the bot answers only when addressed. See "Groups" in README.md.

# Answer when a message calls the bot by name: "Maria, ...", "Hey Maria!",
# "..., Maria?". Needs privacy mode turned OFF in @BotFather, because Telegram
# does not deliver such messages to a bot otherwise.
ENABLE_WAKE_WORD_TRIGGER=true

# Comma-separated names the bot answers to; each a single word, any case.
# Leave empty to use BOT_DISPLAY_NAME. Spellings in Cyrillic must be listed
# too. Do not add "mira": another bot called Mira is in the same groups.
BOT_WAKE_WORDS=maria,mariya,мария,мариа

# Answer when someone writes @your_bot_username.
ENABLE_USERNAME_MENTION=true

# Answer when someone replies to one of the bot's messages.
ENABLE_REPLY_TRIGGER=true

# How many of the last 14 hours' group messages the bot reads before
# answering (0 to 500). Every group message is stored for this, and deleted
# after RETENTION_DAYS; 0 turns it off.
GROUP_AMBIENT_MESSAGES=500

# The groups' time zone: the times shown in the group log, the day the
# daily picture limit counts, and the time the bot gives when nobody names
# another zone.
GROUP_HISTORY_TIMEZONE=Asia/Tashkent

# Telegram usernames of the bot's owners, comma-separated, e.g.
# pronium,TursunoffM. The bot treats owners warmly, follows their
# instructions in the chat and lets them manage it in any group.
BOT_OWNER_USERNAME=

# The owners' numeric Telegram user IDs, comma-separated, e.g. 12345,67890.
# Optional but safer: when set, only these accounts are owners, so someone who
# later takes an owner's old username gains nothing. BOT_OWNER_USERNAME is
# still needed to name the owners. Leave empty to recognise owners by username;
# owners can then moderate only where they are admins themselves.
BOT_OWNER_IDS=

# Other bots to answer in groups: comma-separated usernames, or * for any bot.
# Needs Bot-to-Bot Communication Mode in @BotFather. Empty: ignore bots.
ALLOWED_BOTS=

# Most replies to bots per group in 10 minutes, so two bots cannot keep
# answering each other.
BOT_REPLIES_PER_10_MIN=5

# Each group has one shared conversation with the bot. Only "shared" is supported.
GROUP_CONTEXT_MODE=shared

# Longest answer posted in a group (at most 4096; an emoji usually counts as
# two). Longer answers are cut so the bot posts one message.
MAX_GROUP_REPLY_LENGTH=4000

# Answers per group per minute, across all members. Past this the bot stays
# quiet, without a notice. Not counted: owners, other bots (they have
# BOT_REPLIES_PER_10_MIN), /mute and /unmute from those who may use them, and
# a reply that is only laughter, a sticker or a GIF, which gets a reaction.
# Counted in the database, so it holds on Vercel too.
GROUP_RATE_LIMIT_PER_MINUTE=6

# Answers each member gets per group in 10 minutes, so one member cannot
# keep the bot to themselves. Past this the bot stays quiet with them.
MEMBER_REPLIES_PER_10_MIN=4

# --- Webhook (serverless hosting such as Vercel) ------------------------------
# Not needed for `make run`, which uses long polling.

# A secret you make up (openssl rand -hex 32). Telegram sends it back with
# every update, and the webhook rejects requests without it. Up to 256
# characters from A-Z, a-z, 0-9, _ and -. The deployed function and the
# machine that runs "set-webhook" must have the same value.
TELEGRAM_WEBHOOK_SECRET=

# Protects the daily cleanup endpoint (/api/cleanup) on Vercel. Vercel Cron
# sends it automatically once it is set in the project. At least 16
# characters: openssl rand -hex 32
CRON_SECRET=

# --- Other ------------------------------------------------------------------

# debug, info, warn or error
LOG_LEVEL=info

# Override only for testing or when using a proxy.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# TELEGRAM_API_URL=https://api.telegram.org
