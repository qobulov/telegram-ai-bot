# Copy this file to .env for local development:  cp .env.example .env
# Never commit .env. In production, use a protected environment file instead
# (see "VPS deployment" in README.md).

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The AI model provider: set exactly ONE of these keys.
#
# Google Gemini: key from https://aistudio.google.com/apikey
# The only provider here that can listen to voice messages.
GEMINI_API_KEY=
#
# Or xAI Grok: key from https://console.x.ai
XAI_API_KEY=
#
# Or OpenRouter: key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# PostgreSQL connection string for the bot's runtime role.
# Example: postgres://tgbot:password@127.0.0.1:5432/tgbot?sslmode=disable
DB_POSTGRES_URL=

# --- Model ------------------------------------------------------------------

# Gemini model, used when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-3.5-flash-lite

# Models to try, in order, when the main one is overloaded (503), over its
# limits (429) or does not answer. Empty: the provider's defaults (for
# Gemini: gemini-3.1-flash-lite,gemini-flash-lite-latest). "none": no fallback.
FALLBACK_MODELS=

# Grok model, used when XAI_API_KEY is set. Pick one that accepts images.
XAI_MODEL=grok-4

# OpenRouter model, used when OPENROUTER_API_KEY is set. Any OpenRouter model ID. "openrouter/free" routes to a free model.
# Not every model supports tool calling; see "Choosing a model" in README.md.
OPENROUTER_MODEL=openrouter/free

# Upper limit on tokens in one model reply.
MAX_OUTPUT_TOKENS=1024

# --- Photos, stickers and voice messages -------------------------------------

# Largest file the bot downloads to show the model, in MB (1 to 20).
MAX_MEDIA_MB=5

# Longest voice message the bot listens to, in seconds. Longer ones are
# described to the model but not sent.
MAX_VOICE_SECONDS=120

# --- Limits -----------------------------------------------------------------

# How many recent messages are sent to the model as context.
MAX_HISTORY_MESSAGES=20

# How many tool calls the model may make while answering one message.
MAX_TOOL_CALLS_PER_TURN=4

# Number of workers, i.e. how many messages are processed at the same time.
MAX_CONCURRENT_REQUESTS=10

# Messages each user may send per minute.
USER_RATE_LIMIT_PER_MINUTE=10

# Time budget, in seconds, for answering one message (model + tools).
REQUEST_TIMEOUT_SECONDS=45

# Longest user message accepted, in characters.
MAX_INPUT_CHARS=4000

# Chat history is kept this many days, then deleted (once a day on Vercel,
# hourly with long polling). 0 keeps it forever.
RETENTION_DAYS=1

# --- Access -----------------------------------------------------------------

# Comma-separated Telegram user IDs with administrator rights. Example: 12345,67890
ADMIN_USER_IDS=

# Comma-separated commands only administrators may use. Example: model,about
ADMIN_COMMANDS=

# --- Character --------------------------------------------------------------

# The character's name. It is put into the personality prompt, and is the
# word the bot answers to in groups unless BOT_WAKE_WORDS says otherwise.
BOT_DISPLAY_NAME=Maria

# The character's personality and rules, given to the model on every request.
# "{name}" is replaced by BOT_DISPLAY_NAME. Leave empty for the built-in
# character: witty, sarcastic, brief, with limits on what it jokes about.
# See "The character" in README.md before replacing it.
PERSONA_PROMPT=

# --- Groups -----------------------------------------------------------------
# In groups the bot answers only when addressed. See "Groups" in README.md.

# Answer when a message calls the bot by name: "Maria, ...", "Hey Maria!",
# "..., Maria?". Needs privacy mode turned OFF in @BotFather, because Telegram
# does not deliver such messages to a bot otherwise.
ENABLE_WAKE_WORD_TRIGGER=true

# Comma-separated names the bot answers to; each a single word, any case.
# Leave empty to use BOT_DISPLAY_NAME. Example: maria,мария
BOT_WAKE_WORDS=maria

# Answer when someone writes @your_bot_username.
ENABLE_USERNAME_MENTION=true

# Answer when someone replies to one of the bot's messages.
ENABLE_REPLY_TRIGGER=true

# How many of today's group messages the bot reads before answering (0 to
# 500). Every group message is stored for the day for this; 0 turns it off.
GROUP_AMBIENT_MESSAGES=200

# Time zone that decides when "today" starts for the group log.
GROUP_HISTORY_TIMEZONE=Asia/Tashkent

# Telegram usernames of the bot's owners, comma-separated, e.g.
# pronium,TursunoffM. The bot treats owners warmly, follows their
# instructions in the chat and lets them manage it in any group.
BOT_OWNER_USERNAME=

# Each group has one shared conversation with the bot. Only "shared" is supported.
GROUP_CONTEXT_MODE=shared

# Longest answer posted in a group (at most 4096; an emoji usually counts as
# two). Longer answers are cut so the bot posts one message.
MAX_GROUP_REPLY_LENGTH=4000

# Messages the bot answers per group per minute, across all members.
GROUP_RATE_LIMIT_PER_MINUTE=10

# --- Webhook (serverless hosting such as Vercel) ------------------------------
# Not needed for `make run`, which uses long polling.

# A secret you make up (openssl rand -hex 32). Telegram sends it back with
# every update, and the webhook rejects requests without it. Up to 256
# characters from A-Z, a-z, 0-9, _ and -. The deployed function and the
# machine that runs "set-webhook" must have the same value.
TELEGRAM_WEBHOOK_SECRET=

# Protects the daily cleanup endpoint (/api/cleanup) on Vercel. Vercel Cron
# sends it automatically once it is set in the project. At least 16
# characters: openssl rand -hex 32
CRON_SECRET=

# --- Other ------------------------------------------------------------------

# debug, info, warn or error
LOG_LEVEL=info

# Override only for testing or when using a proxy.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TELEGRAM_API_URL=https://api.telegram.org
