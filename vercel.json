{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/webhook.go": {
      "maxDuration": 60
    },
    "api/cleanup.go": {
      "maxDuration": 60
    },
    "api/reminders.go": {
      "maxDuration": 30
    },
    "api/stats.go": {
      "maxDuration": 15
    },
    "api/cards.go": {
      "maxDuration": 30
    },
    "api/game.go": {
      "maxDuration": 15
    },
    "api/raid.go": {
      "maxDuration": 15
    },
    "api/mafia.go": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/kartalar/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/kartalar/(app.js|style.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
